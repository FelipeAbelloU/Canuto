# Entorno virtual
venv/
.venv/
# entorno aparte para el OCR docling (workstation)
venv-docling/

# Checkpoints del modelo (3 GB — demasiado grandes para GitHub)
data/checkpoints/

# Corpus PDF de SIRIUS (~5 GB — se transfiere aparte por USB/disco, no por git)
PDF/

# Textos extraídos (se regeneran con scripts/extract_text.py)
data/extracted/

# Dataset y splits (se regeneran con build_dataset.py y split_dataset.py)
data/dataset/dataset_alpaca.json
data/dataset/train.json
data/dataset/test.json

# Respuestas generadas y metricas de cada corrida (salida de evaluate.py)
data/eval/

# Cola de OCR para la workstation (se regenera al correr extract_text.py)
data/_ocr_queue.txt

# Registro local de W&B (las corridas viven en wandb.ai)
wandb/

# Cache de Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# Artefactos de descarga HuggingFace
*.incomplete
*.lock

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# IDEs
.idea/

# Scripts y volcados de trabajo local
barrido.sh
cookies.txt
